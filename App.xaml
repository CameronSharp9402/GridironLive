<Application x:Class="GridironLive.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">

    <Application.Resources>

        <!-- Application colors -->
        <Color x:Key="BackgroundColor">#101116</Color>
        <Color x:Key="PanelColor">#191B23</Color>
        <Color x:Key="CardColor">#20232D</Color>
        <Color x:Key="BorderColor">#303440</Color>
        <Color x:Key="AccentColor">#8B5CF6</Color>
        <Color x:Key="TextColor">#F4F4F5</Color>
        <Color x:Key="MutedColor">#9295A3</Color>
        <Color x:Key="GreenColor">#22C55E</Color>
        <Color x:Key="RedColor">#EF4444</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush"
                         Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="PanelBrush"
                         Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="CardBrush"
                         Color="{StaticResource CardColor}"/>
        <SolidColorBrush x:Key="BorderBrush"
                         Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="AccentBrush"
                         Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="TextBrush"
                         Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="MutedBrush"
                         Color="{StaticResource MutedColor}"/>
        <SolidColorBrush x:Key="GreenBrush"
                         Color="{StaticResource GreenColor}"/>

        <!-- Global typography -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily"
                    Value="Segoe UI"/>
        </Style>

        <!-- Dashboard buttons -->
        <Style x:Key="DashboardButton"
               TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#292C38"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark dropdown item styling -->
        <Style x:Key="DarkComboBoxItem"
       TargetType="ComboBoxItem">

            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="Background" Value="#292C38"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment"
            Value="Stretch"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">

                        <Border x:Name="ItemBorder"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsHighlighted"
                             Value="True">
                                <Setter TargetName="ItemBorder"
                                Property="Background"
                                Value="#414557"/>
                            </Trigger>

                            <Trigger Property="IsSelected"
                             Value="True">
                                <Setter TargetName="ItemBorder"
                                Property="Background"
                                Value="#514078"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                             Value="False">
                                <Setter Property="Foreground"
                                Value="#777777"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
