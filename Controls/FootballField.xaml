<UserControl x:Class="GridironLive.Controls.FootballField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="190">

    <Border Background="#17251F"
            BorderBrush="#303440"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- FIELD HEADER -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,10">

                <TextBlock Text="FIELD POSITION"
                           Foreground="#A78BFA"
                           FontSize="11"
                           FontWeight="Bold"/>

                <TextBlock x:Name="SituationText"
                           Grid.Column="1"
                           Text="Waiting for game data..."
                           Foreground="#B6BCCB"
                           FontSize="10"
                           HorizontalAlignment="Right"/>
            </Grid>

            <!-- FIELD -->
            <Grid Grid.Row="1"
                  ClipToBounds="True">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="35"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="35"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT END ZONE -->
                <Border Grid.Column="0"
                        Background="#244B39">

                    <TextBlock Text="HOME"
                               Foreground="#D1FAE5"
                               FontSize="9"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="-90"/>
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Border>

                <!-- PLAYING FIELD -->
                <Grid x:Name="PlayingField"
                      Grid.Column="1"
                      Background="#28543F">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- YARD LINES -->
                    <Border Grid.Column="0"
                            BorderBrush="#6686A58C"
                            BorderThickness="1,0,0,0"/>

                    <Border Grid.Column="1"
                            BorderBrush="#6686A58C"
                            BorderThickness="1,0,0,0"/>

                    <Border Grid.Column="2"
                            BorderBrush="#6686A58C"
                            BorderThickness="1,0,0,0"/>

                    <Border Grid.Column="3"
                            BorderBrush="#6686A58C"
                            BorderThickness="1,0,0,0"/>

                    <Border Grid.Column="4"
                            BorderBrush="#6686A58C"
                            BorderThickness="1,0,0,0"/>

                    <Border Grid.Column="5"
                            BorderBrush="#6686A58C"
                            BorderThickness="1,0,0,0"/>

                    <Border Grid.Column="6"
                            BorderBrush="#6686A58C"
                            BorderThickness="1,0,0,0"/>

                    <Border Grid.Column="7"
                            BorderBrush="#6686A58C"
                            BorderThickness="1,0,0,0"/>

                    <Border Grid.Column="8"
                            BorderBrush="#6686A58C"
                            BorderThickness="1,0,0,0"/>

                    <Border Grid.Column="9"
                            BorderBrush="#6686A58C"
                            BorderThickness="1,0,0,0"/>

                    <!-- YARD NUMBERS -->
                    <TextBlock Text="10"
                               Grid.Column="0"
                               Foreground="#D1FAE5"
                               FontSize="9"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,5,0,0"/>

                    <TextBlock Text="20"
                               Grid.Column="1"
                               Foreground="#D1FAE5"
                               FontSize="9"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,5,0,0"/>

                    <TextBlock Text="30"
                               Grid.Column="2"
                               Foreground="#D1FAE5"
                               FontSize="9"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,5,0,0"/>

                    <TextBlock Text="40"
                               Grid.Column="3"
                               Foreground="#D1FAE5"
                               FontSize="9"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,5,0,0"/>

                    <TextBlock Text="50"
                               Grid.Column="4"
                               Foreground="#FFFFFF"
                               FontSize="10"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,5,0,0"/>

                    <TextBlock Text="40"
                               Grid.Column="5"
                               Foreground="#D1FAE5"
                               FontSize="9"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,5,0,0"/>

                    <TextBlock Text="30"
                               Grid.Column="6"
                               Foreground="#D1FAE5"
                               FontSize="9"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,5,0,0"/>

                    <TextBlock Text="20"
                               Grid.Column="7"
                               Foreground="#D1FAE5"
                               FontSize="9"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,5,0,0"/>

                    <TextBlock Text="10"
                               Grid.Column="8"
                               Foreground="#D1FAE5"
                               FontSize="9"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,5,0,0"/>

                    <!-- LINE OF SCRIMMAGE -->
                    <Border x:Name="LineOfScrimmage"
                            Grid.Column="0"
                            Grid.ColumnSpan="10"
                            Width="2"
                            Background="#60A5FA"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed"/>

                    <!-- FIRST DOWN LINE -->
                    <Border x:Name="FirstDownLine"
                            Grid.Column="0"
                            Grid.ColumnSpan="10"
                            Width="2"
                            Background="#FACC15"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed"/>

                    <!-- BALL MARKER -->
                    <Border x:Name="BallMarker"
                            Width="12"
                            Height="12"
                            Background="#FFFFFF"
                            BorderBrush="#111827"
                            BorderThickness="2"
                            CornerRadius="6"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"/>

                </Grid>

                <!-- RIGHT END ZONE -->
                <Border Grid.Column="2"
                        Background="#244B39">

                    <TextBlock Text="AWAY"
                               Foreground="#D1FAE5"
                               FontSize="9"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="90"/>
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Border>

            </Grid>

            <!-- FIELD LEGEND -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,0">

                <Rectangle Width="10"
                          Height="3"
                          Fill="#60A5FA"
                          VerticalAlignment="Center"/>

                <TextBlock Text=" Ball"
                           Foreground="#B6BCCB"
                           FontSize="9"
                           Margin="4,0,12,0"/>

                <Rectangle Width="10"
                          Height="3"
                          Fill="#FACC15"
                          VerticalAlignment="Center"/>

                <TextBlock Text=" First Down"
                           Foreground="#B6BCCB"
                           FontSize="9"
                           Margin="4,0,0,0"/>

            </StackPanel>

        </Grid>
    </Border>
</UserControl>
